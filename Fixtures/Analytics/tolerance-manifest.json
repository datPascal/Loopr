{
  "$schema": "https://loopr.local/schemas/analytics-tolerance-manifest-v1.json",
  "version": 1,
  "purpose": "ANA-01 per-field Dart/Swift analytics parity. Unlisted fields compare exactly.",
  "categories": {
    "exact": {
      "rule": "Exact equality for presence, absence, confidence tiers, labels, day identity, stage classes, counts, flags, algorithm versions, byte/protocol and storage values.",
      "applies_to": ["presence", "absence", "confidence", "tier", "labels", "day_identity", "stage_class", "counts", "flags", "algorithm_version", "byte", "storage"]
    },
    "canonical-rounded": {
      "rule": "Apply the same canonical display rounding before exact comparison.",
      "decimals": 0,
      "applies_to": ["integer_seconds", "displayed_rounded_values"]
    },
    "float-primitive": {
      "rule": "Absolute tolerance for primitive floating-point operations.",
      "absolute": 1e-9
    },
    "normalized-score": {
      "rule": "Absolute tolerance for normalized scores and ordinary scalar pipelines.",
      "absolute": 1e-6
    },
    "spectral-iterative": {
      "rule": "Relative tolerance with an absolute floor for spectral and iterative outputs.",
      "relative": 1e-5,
      "absolute_floor": 1e-8
    }
  },
  "entries": [
